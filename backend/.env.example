# ---- Server ----
PORT=5000
NODE_ENV=development

# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/canteenDB

# ---- Security ----
# REQUIRED. Generate a strong value with:  npm run generate:secret
# The server refuses to start in production if this is left at a known-weak default.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=300

# ---- Business rules ----
ORDER_MAX_QUANTITY=20
ORDER_MAX_ITEMS=30

# ---- Email verification (OTP) ----
# "log" records codes in the server log (tests/dev);
# "anypost" sends them through the Anypost HTTP API.
OTP_MAILER=anypost
# Anypost API key (https://anypost.com — free tier:
# 100 emails/day, 1 sending domain).
ANYPOST_API_KEY=
# Address the verification email is sent from. Must
# belong to a domain verified in the Anypost panel.
OTP_FROM_EMAIL=campusbites@campusbites.in
# Abuse protection (provider allows 100 emails/day;
# the app holds 10 back).
OTP_COOLDOWN_SECONDS=60
OTP_PER_HOUR=3
OTP_PER_DAY=5
OTP_PER_IP_DAY=20
OTP_GLOBAL_DAILY=90
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Phase 2 lifecycle. false (default) lets staff/admin skip ahead along the
# forward path (Pending -> Preparing, Pending -> Completed), preserving the
# original admin workflow. Set true to require every stage:
#   Pending -> Accepted -> Preparing -> Ready -> Completed
ORDER_STRICT_LIFECYCLE=false

# ---- Admin seed script (optional, used only by `npm run seed:admin`) ----
# ADMIN_EMAIL=head@college.edu
# ADMIN_NAME=Canteen Admin
# ADMIN_PASSWORD=
# ADMIN_ROLE=admin
